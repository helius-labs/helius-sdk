{
  "name": "helius-sdk",
  "version": "3.0.0",
  "description": "A Helius TypeScript SDK for building the future of Solana — DAS API, Sender, Webhooks, Laserstream, ZK Compression, and Solana RPC primitives. Built on @solana/kit.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helius-labs/helius-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/helius-labs/helius-sdk/issues"
  },
  "homepage": "https://github.com/helius-labs/helius-sdk#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/rpc/index.d.ts",
      "import": "./dist/esm/rpc/index.js",
      "require": "./dist/cjs/rpc/index.cjs"
    },
    "./rpc": {
      "types": "./dist/esm/rpc/index.d.ts",
      "import": "./dist/esm/rpc/index.js",
      "require": "./dist/cjs/rpc/index.cjs"
    },
    "./rpc/eager": {
      "types": "./dist/esm/rpc/createHelius.eager.d.ts",
      "import": "./dist/esm/rpc/createHelius.eager.js",
      "require": "./dist/cjs/rpc/createHelius.eager.cjs"
    },
    "./rpc/methods/*": {
      "types": "./dist/esm/rpc/methods/*.d.ts",
      "import": "./dist/esm/rpc/methods/*.js",
      "require": "./dist/cjs/rpc/methods/*.cjs"
    },
    "./transactions/*": {
      "types": "./dist/esm/transactions/*.d.ts",
      "import": "./dist/esm/transactions/*.js",
      "require": "./dist/cjs/transactions/*.cjs"
    },
    "./rpc/wrapAutoSend": {
      "types": "./dist/esm/rpc/wrapAutoSend.d.ts",
      "import": "./dist/esm/rpc/wrapAutoSend.js",
      "require": "./dist/cjs/rpc/wrapAutoSend.cjs"
    },
    "./webhooks/*": {
      "types": "./dist/esm/webhooks/*.d.ts",
      "import": "./dist/esm/webhooks/*.js",
      "require": "./dist/cjs/webhooks/*.cjs"
    },
    "./enhanced/*": {
      "types": "./dist/esm/enhanced/*.d.ts",
      "import": "./dist/esm/enhanced/*.js",
      "require": "./dist/cjs/enhanced/*.cjs"
    },
    "./staking/*": {
      "types": "./dist/esm/staking/*.d.ts",
      "import": "./dist/esm/staking/*.js",
      "require": "./dist/cjs/staking/*.cjs"
    },
    "./websockets/*": {
      "types": "./dist/esm/websockets/*.d.ts",
      "import": "./dist/esm/websockets/*.js",
      "require": "./dist/cjs/websockets/*.cjs"
    },
    "./zk/*": {
      "types": "./dist/esm/zk/*.d.ts",
      "import": "./dist/esm/zk/*.js",
      "require": "./dist/cjs/zk/*.cjs"
    },
    "./wallet/*": {
      "types": "./dist/esm/wallet/*.d.ts",
      "import": "./dist/esm/wallet/*.js",
      "require": "./dist/cjs/wallet/*.cjs"
    },
    "./types/*": {
      "types": "./dist/esm/types/*.d.ts",
      "import": "./dist/esm/types/*.js",
      "require": "./dist/cjs/types/*.cjs"
    },
    "./auth/*": {
      "types": "./dist/esm/auth/*.d.ts",
      "import": "./dist/esm/auth/*.js",
      "require": "./dist/cjs/auth/*.cjs"
    },
    "./admin/*": {
      "types": "./dist/esm/admin/*.d.ts",
      "import": "./dist/esm/admin/*.js",
      "require": "./dist/cjs/admin/*.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prebuild": "node -p \"'export const version = \\'' + require('./package.json').version + '\\';'\" > src/version.ts",
    "build": "rimraf dist && rollup -c",
    "prepare": "simple-git-hooks && pnpm run build",
    "lint": "eslint src",
    "format": "prettier --write 'src/**/*.{js,ts,json,md}'",
    "format:check": "prettier --cache --check 'src/**/*.{js,ts,json,md}'",
    "bundle:size": "bundlemon",
    "check-all-tree": "node check-all-tree-shake.js",
    "check-bundle": "pnpm run build && pnpm check-all-tree && bundlemon",
    "changelog": "auto-changelog --template keepachangelog",
    "docs:build": "typedoc",
    "docs:open": "typedoc && npx --yes http-server docs -o -c-1"
  },
  "keywords": [
    "helius",
    "solana",
    "web3",
    "sdk",
    "typescript",
    "rpc",
    "das",
    "das-api",
    "nft",
    "compressed-nft",
    "cnft",
    "webhooks",
    "laserstream",
    "sender",
    "priority-fees",
    "smart-transactions",
    "zk-compression"
  ],
  "author": "Helius",
  "license": "MIT",
  "dependencies": {
    "bs58": "^6.0.0",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@solana-program/compute-budget": "^0.15.0",
    "@solana-program/stake": "^0.6.1",
    "@solana-program/system": "^0.12.0",
    "@solana-program/token": "^0.13.0",
    "@solana/kit": "^6.9.0"
  },
  "pnpm": {
    "overrides": {
      "axios": ">=1.15.2",
      "diff": ">=4.0.4",
      "flatted": ">=3.4.2",
      "follow-redirects": ">=1.16.0",
      "handlebars": ">=4.7.9",
      "js-yaml": ">=4.1.1",
      "lodash": ">=4.18.1",
      "lodash-es": ">=4.18.0",
      "minimatch@^3": "^3.1.3",
      "minimatch@^5": "^5.1.8",
      "minimatch@^9": "^9.0.7",
      "minimatch@^10": "^10.2.5",
      "picomatch@^2": "^2.3.2",
      "picomatch@^4": "^4.0.4"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "src/**/*.{js,ts,json,md}": "prettier --write"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@solana-program/compute-budget": "^0.15.0",
    "@solana-program/stake": "^0.6.1",
    "@solana-program/system": "^0.12.0",
    "@solana-program/token": "^0.13.0",
    "@solana/kit": "^6.9.0",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "agadoo": "^3.0.0",
    "auto-changelog": "^2.5.0",
    "bundlemon": "^3.1.0",
    "eslint": "^9.30.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.1",
    "glob": "^11.0.3",
    "jest": "^30.0.4",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "rollup": "^4.44.2",
    "simple-git-hooks": "^2.13.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typedoc": "^0.28.17",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.26.0+sha512.3b3f6c725ebe712506c0ab1ad4133cf86b1f4b687effce62a9b38b4d72e3954242e643190fc51fa1642949c735f403debd44f5cb0edd657abe63a8b6a7e1e402"
}
